# Unreal Engine / Visual Studio
Binaries/
DerivedDataCache/
Intermediate/
Saved/
# Build/ contains checked-in packaging and profiling scripts.
*.sln
*.suo
*.opensdf
*.sdf
*.VC.db
*.VC.opendb
.vs/
*.xcodeproj
*.xcworkspace

# Mac packaging files regenerated by the editor/UAT (Info.Template.plist, version counter,
# file open order, default sandbox entitlements). Keep project branding, its
# packaging finalizer, and unsandboxed entitlements for retail DAT access.
/Build/Mac/*
!/Build/Mac/Application.icns
!/Build/Mac/Finalize-App.py
!/Build/Mac/Resources/
/Build/Mac/Resources/*
!/Build/Mac/Resources/ACUnreal.Unsandboxed.entitlements

# Local
*.log
*.pdb
*.exe
*.dll
*.target
*.modules

# Generated retail DAT imports; the runtime reads the user's DAT installation.
/Content/*
!/Content/ACE/
/Content/ACE/*
!/Content/ACE/RuntimeMaterials/
/diag/*
!/diag/UIInventory/
/PackagedVR/
/UpgradeLog*.htm

# Ad-hoc validation/capture output outside the usual Saved directory.
/Automation/
/Validation/
/Captures/
/Testing/
